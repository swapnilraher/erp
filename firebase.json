{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/login",
        "destination": "https://erp-system-psi-one.vercel.app/login",
        "type": 302
      },
      {
        "source": "/register",
        "destination": "https://erp-system-psi-one.vercel.app/register",
        "type": 302
      },
      {
        "source": "/dashboard",
        "destination": "https://erp-system-psi-one.vercel.app/dashboard",
        "type": 302
      },
      {
        "source": "/dashboard/**",
        "destination": "https://erp-system-psi-one.vercel.app/dashboard",
        "type": 302
      },
      {
        "source": "/app",
        "destination": "https://erp-system-psi-one.vercel.app/dashboard",
        "type": 302
      },
      {
        "source": "/app/**",
        "destination": "https://erp-system-psi-one.vercel.app/dashboard",
        "type": 302
      },
      {
        "source": "/privacy-policy",
        "destination": "/privacy",
        "type": 301
      }
    ]
  }
}
